    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "\n",
    "print(\"NumPy version:\", np.__version__)\n",
    "\n",
    "x = np.array([1, 2, 3])\n",
    "y = np.array([3, 5, 7])\n",
    "\n",
    "plt.scatter(x, y)\n",
    "plt.xlabel(\"x\")\n",
    "plt.ylabel(\"y\")\n",
    "plt.title(\"data\")\n",
    "plt.show()"
   ]
  }
